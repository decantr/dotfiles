[include]
	path = ~/.config/git/config.d/extra

[commit]
	gpgsign = true

[init]
	defaultBranch = master

[alias]
	a = add
	b = branch
	d = diff
	m = merge --no-ff
	p = push
	r = reset
	st = stash

	ap = add -p
	c = commit -S
	ca = commit -S -a
	cam = ca --am
	came = ca --am --no-edit
	cd = checkout
	cm = c -m
	cme = c --am --no-edit
	cp = cherry-pick
	dc = diff --cached
	l = !git --no-pager log --oneline -n 5
	lg = !git --no-pager log --oneline -n 5 --graph
	ll = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
	m3 = merge --no-ff
	s = status -s --untracked-files=no --ignore-submodules=dirty
	sa = status -s
	sh = show --name-only --oneline
	t = tag -s
	prp = pull --rebase --prune
	rh = reset --hard

	fix-cur  = !git diff --name-only | xargs -I@ make fmt _file=@
	fix-last = !git show --pretty="format:" --name-only | xargs -I@ make fmt _file=@
	forget-list="!git fetch -p && git branch -vv | awk '/: gone]/{print $1}'"
	forget-all="!git fetch -p && git branch -vv | awk '/: gone]/{print $1}' | xargs git branch -D"

	dmp="! \
		curbranch=\"$(git branch --show-current)\" \
		dirty=\"$(git status -s --untracked-files=no --ignore-submodules=dirty)\" \
		&& ( ([[ $dirty ]] && git stash) || echo &> /dev/null ) \
		&& git checkout develop \
		&& git merge --no-ff \"$curbranch\" -m \"merge: $curbranch\" \
		&& git push \
		&& git cd \"$curbranch\" \
		&& ( ([[ $dirty ]] && git stash pop) || echo &> /dev/null ) \
	"
