#!/bin/sh

# pids frozen by hand, one per line; `start` leaves these alone
state_file=/tmp/freeze-simple.state

_notify() {
	command -v notify-send >/dev/null || return 0
	notify-send -a "freeze" -u "${2:-normal}" -t 3000 -h "string:x-canonical-private-synchronous:freeze" "Freeze" "$1" 2>/dev/null || true
}

_info() {
	echo ":: $(date -u "+%F %T") : $1"
}

_error() {
	echo "!! $(date -u "+%F %T") : $1"
	exit 1
}

pidTree() {
	echo "$1"
	for child in $(pgrep -P "$1"); do
		pidTree "$child"
	done
}

signalTree() {
	# shellcheck disable=SC2046
	kill -s "$1" $(pidTree "$2") 2>/dev/null
}

isManual() {
	grep -qx "$1" "$state_file" 2>/dev/null
}

recordManual() {
	echo "$1" >>"$state_file"
}

forgetManual() {
	[ -f "$state_file" ] || return 0
	grep -vx "$1" "$state_file" >"$state_file.tmp"
	mv "$state_file.tmp" "$state_file"
}

focusedPid() {
	swaymsg -t get_tree | jq -r 'first(recurse(.nodes[]?, .floating_nodes[]?) | select(.focused) | .pid // empty)'
}

toggleWindow() {
	window_pid=$(focusedPid)
	case "$window_pid" in
		"" | *[!0-9]*)
			_notify "No focused window with a pid" critical
			_error "No focused window with a pid"
			;;
	esac

	window_stat=$(ps -o stat= -p "$window_pid")
	[ -n "$window_stat" ] || _error "Process $window_pid is gone"

	case "$window_stat" in
		T*)
			signalTree CONT "$window_pid"
			forgetManual "$window_pid"
			_info "Resumed $window_pid"
			_notify "Resumed $window_pid"
			;;
		*)
			recordManual "$window_pid"
			signalTree STOP "$window_pid"
			_info "Froze $window_pid"
			_notify "Froze $window_pid"
			;;
	esac
}

# comm is cut at 15 chars and an AppImage runs under a different comm, so also match argv[0]'s basename
findPids() {
	{
		pgrep -x -U "$(id -u)" "$1" 2>/dev/null
		pgrep -f -U "$(id -u)" "^([^ ]*/)?$1( |\$)"
	} | sort -u
}

stopByName() {
	for name in "$@"; do
		for named_pid in $(findPids "$name"); do
			signalTree STOP "$named_pid"
		done
	done
}

startByName() {
	for name in "$@"; do
		for named_pid in $(findPids "$name"); do
			isManual "$named_pid" || signalTree CONT "$named_pid"
		done
	done
}

resumeAll() {
	[ -f "$state_file" ] || return 0
	while read -r manual_pid; do
		signalTree CONT "$manual_pid"
	done <"$state_file"
	: >"$state_file"
}

action=${1:-}
[ $# -gt 0 ] && shift

case "$action" in
	window) toggleWindow ;;
	resume-all) resumeAll ;;
	stop) stopByName "$@" ;;
	start) startByName "$@" ;;
	*) _info "Usage: freeze-simple window | resume-all | stop <prog>... | start <prog>..." ;;
esac
