#!/usr/bin/env bash
#
# SIGKILL the focused window's process.
#
# Kills only the window's own pid, never its ancestors. For games launched
# through Steam/Proton the focused pid is a wrapper (bwrap/Wine) whose
# descendant tree reaches shared helpers, so walking the tree would take
# down Steam and launchers — avoid that and kill just the target.
#
# Usage:
#   kill-focus	kill -9 the focused window (children only with --tree)
#
# Binds niri (~/.config/niri/dms/binds.kdl):
#   Mod+Shift+Q { spawn "/path/to/kill-focus"; }

set -u

notify() {
	notify-send -a "kill-focus" -u "$2" \
		-h "string:x-canonical-private-synchronous:kill-focus" \
		"Kill" "$1"
}

_info() {
	printf ':: %s : %s\n' "$(date -u '+%F %T')" "$1"
	notify "$1" low
}

_error() {
	printf '!! %s : %s\n' "$(date -u '+%F %T')" "$1" >&2
	notify "$1" normal
	exit 1
}

requireCommands() {
	local cmd
	for cmd in "$@"; do
		command -v "$cmd" >/dev/null || _error "$cmd is required but not installed"
	done
}

# sets pid, title and name for the focused window
findFocusedWindow() {
	local raw

	raw=$(niri msg --json focused-window 2>/dev/null |
		jq -er 'select(.pid)
				| "\(.pid)\t\(.title // "…")\t\(first((.app_id, .title, "window")
								   | select(. != null and . != "")))"')
	[[ -n "$raw" ]] || _error "No focused window"
	IFS=$'\t' read -r pid title name <<<"$raw"
	[[ "$pid" =~ ^[0-9]+$ ]] || _error "No pid for $name"
}

commOf() {
	cat "/proc/$1/comm" 2>/dev/null
}

# true when pid is the shared XWayland server, not a real window owner
isXwayland() {
	[[ "$(commOf "$1")" =~ ^(xwayland|Xwayland) ]]
}

# true when pid's cmdline is a steam pressure-vessel container root
isContainer() {
	tr '\0' ' ' < "/proc/$1/cmdline" 2>/dev/null | grep -qE '/(srt-bwrap|bwrap|pv-adverb)'
}

# prints the first container ancestor walking up from pid, if any
findContainerAncestor() {
	local p=$1
	while ((p > 1)) && [[ -n "$p" ]]; do
		isContainer "$p" && { printf '%s\n' "$p"; return 0; }
		p=$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')
	done
	return 1
}

# true when pid's ancestors include a reaper SteamLaunch (a game launch
# tree, not the steam client's own sandbox)
inGameLaunch() {
	local p=$1
	while ((p > 1)) && [[ -n "$p" ]]; do
		tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null | grep -q 'reaper.*SteamLaunch' && return 0
		p=$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')
	done
	return 1
}

# niri reports the XWayland server pid for X11 windows. Resolve the real
# client pid via _NET_WM_PID so we never SIGKILL the shared X server.
resolveRealPid() {
	local esc xid real
	[[ -z "$title" ]] && return 1
	esc=$(printf '%s' "$title" | sed 's/[][\.*^$(){}?+|]/\\&/g')
	xid=$(xdotool search --name "$esc" 2>/dev/null | head -1)
	[[ -n "$xid" ]] || return 1
	real=$(xdotool getwindowpid "$xid" 2>/dev/null)
	[[ "$real" =~ ^[0-9]+$ ]] && { pid="$real"; return 0; }
	return 1
}

uid_is_same() {
	[[ "$(ps -o uid= -p "$1" 2>/dev/null | tr -d ' ')" == "$(id -u)" ]]
}

# prints the pid then every descendant, parents before children.
collectTree() {
	local kid
	printf '%s\n' "$1"
	for kid in $(pgrep -P "$1" 2>/dev/null); do
		collectTree "$kid"
	done
}

main() {
	local pids tree=0

	requireCommands niri jq ps pgrep notify-send xdotool

	while (($#)); do
		case "$1" in
			--tree) tree=1 ;;
			*) _error "unknown option: $1" ;;
		esac
		shift
	done

	findFocusedWindow

	# X11 windows are owned by the shared XWayland server for niri; SIGKILLing
	# it takes down every X client (Steam included). Resolve the real pid first.
	if isXwayland "$pid"; then
		resolveRealPid || _error "Could not resolve X11 pid for $name"
	fi

	kill -0 "$pid" 2>/dev/null || _error "$name is gone"

	# never kill processes that are not owned by this user
	uid_is_same "$pid" || _error "Refusing to kill $name — not owned by you"

	# A crashed Proton game is a zombie inside the game's own pressure-vessel
	# container (pv-adverb), below the reaper. Killing that container root
	# removes the game and its wine stack without touching Steam's client tree.
	container=$(findContainerAncestor "$pid") || container=
	if inGameLaunch "$pid" && [[ -n "$container" ]]; then
		pids=()
		mapfile -t pids < <(collectTree "$container")
		name="$name (container)"
	elif [[ "${tree:-0}" == 1 ]]; then
		mapfile -t pids < <(collectTree "$pid")
	else
		pids=("$pid")
	fi

	_info "SIGKILL $name ($pid)"
	kill -9 "${pids[@]}" 2>/dev/null
}

main "$@"
