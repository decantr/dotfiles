#!/bin/sh
#
# Create a git worktree beside the current repo and bootstrap it.
#
# Repo-specific install steps live in that repo's `make bootstrap` target; this
# script only creates the worktree and hands off.
#
# Usage:
#   worktree <branch> [path]

# === helpers =================================================================

set -u

_info() {
	echo ":: $(date -u "+%F %T") : $1"
}

_error() {
	echo "!! $(date -u "+%F %T") : $1"
	exit 1
}

_confirm() {
	# non-interactive callers keep the old behaviour: no prompt, just proceed
	[ -t 0 ] || return 0
	printf "?? %s : %s [y/N] " "$(date -u "+%F %T")" "$1"
	read -r reply
	case "$reply" in
		y | Y | yes | Yes) ;;
		*) _error "aborted" ;;
	esac
}

# === action =================================================================

[ $# -ge 1 ] || _error "usage: worktree <branch> [path]"

branch="$1"

root="$(git rev-parse --show-toplevel 2>/dev/null)" ||
	_error "not inside a git repository"

if [ $# -ge 2 ]; then
	path="$2"
else
	slug="$(echo "$branch" | tr '/' '-')"
	path="$(dirname "$root")/$(basename "$root")-$slug"
fi

if [ -e "$path" ]; then
	_error "path already exists: $path"
fi

base="$(git rev-parse --abbrev-ref HEAD)"
if [ "$base" = "HEAD" ]; then
	base="$(git rev-parse --short HEAD)"
fi

if git show-ref --verify --quiet "refs/heads/$branch"; then
	_confirm "worktree for existing branch $branch at $path?"
	_info "adding worktree for existing branch $branch"
	git worktree add "$path" "$branch" || _error "git worktree add failed"
else
	_confirm "branch $branch does not exist, create it from $base at $path?"
	_info "adding worktree for new branch $branch off $base"
	git worktree add -b "$branch" "$path" || _error "git worktree add failed"
fi

cd "$path" || _error "cannot enter $path"

if command -v mise > /dev/null 2>&1; then
	_info "trusting mise config"
	mise trust > /dev/null || _info "mise trust failed, continuing"
else
	_info "mise not found, skipping trust"
fi

if command -v make > /dev/null 2>&1; then
	# make exits 2 both for a missing target and for a broken Makefile; only the
	# "no rule to make target bootstrap" message tells them apart
	probe="$(make -n bootstrap 2>&1 > /dev/null)"
	probe_status=$?
	if [ "$probe_status" -eq 0 ]; then
		_info "running make bootstrap"
		make bootstrap || _error "make bootstrap failed"
	elif echo "$probe" | grep -qE "(o rule to make target|on't know how to make) .?bootstrap"; then
		_info "no bootstrap target, skipping install"
	else
		_error "cannot read this repo's makefile: $probe"
	fi
else
	_info "make not found, skipping install"
fi

_info "ready: $path"
