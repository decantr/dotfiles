#!/bin/sh

# pids frozen by hand, one per line; `start` leaves these alone
state_file=/tmp/freeze.state

# names matched against `ps -o comm`; xwayland would freeze every X11 app at once
skip_list='^(systemd|niri|sway|dms|qs|quickshell|dbus-daemon|dbus-broker|pipewire|wireplumber|mako|Xwayland|xwayland-satell)$'

_notify() {
	command -v notify-send >/dev/null || return 0
	notify-send -a "freeze" -u "${2:-normal}" -t 3000 -h "string:x-canonical-private-synchronous:freeze" "Freeze" "$1" 2>/dev/null || true
}

_info() {
	echo ":: $(date -u "+%F %T") : $1"
}

_error() {
	echo "!! $(date -u "+%F %T") : $1"
	_notify "$1" critical
	exit 1
}

requireCommands() {
	for cmd in "$@"; do
		command -v "$cmd" >/dev/null || _error "$cmd is required but not installed"
	done
}

pidTree() {
	echo "$1"
	for child in $(pgrep -P "$1"); do
		pidTree "$child"
	done
}

signalTree() {
	# shellcheck disable=SC2046
	kill -s "$1" $(pidTree "$2") 2>/dev/null
}

isSkipped() {
	ps -o comm= -p "$1" | grep -Eq "$skip_list" && return 0

	# freezing an ancestor of this script would stop it mid-run
	ancestor=$$
	while [ -n "$ancestor" ] && [ "$ancestor" != 0 ]; do
		[ "$1" = "$ancestor" ] && return 0
		ancestor=$(ps -o ppid= -p "$ancestor" | tr -d ' ')
	done
	return 1
}

isHeldManual() {
	held_pid=$1
	while [ -n "$held_pid" ] && [ "$held_pid" != 0 ]; do
		grep -qx "$held_pid" "$state_file" 2>/dev/null && return 0
		held_pid=$(ps -o ppid= -p "$held_pid" | tr -d ' ')
	done
	return 1
}

recordManual() {
	echo "$1" >>"$state_file"
}

forgetManual() {
	[ -f "$state_file" ] || return 0
	grep -vx "$1" "$state_file" >"$state_file.tmp"
	mv "$state_file.tmp" "$state_file"
}

focusedPid() {
	if [ -n "${NIRI_SOCKET:-}" ]; then
		niri msg --json focused-window 2>/dev/null | jq -r '.pid // empty'
	else
		swaymsg -t get_tree 2>/dev/null | jq -r 'first(recurse(.nodes[]?, .floating_nodes[]?) | select(.focused) | .pid // empty)'
	fi
}

requirePid() {
	case "$1" in
		"" | *[!0-9]*) _error "$2" ;;
	esac
}

toggleWindow() {
	if [ -n "${NIRI_SOCKET:-}" ]; then
		requireCommands niri
	elif [ -n "${SWAYSOCK:-}" ]; then
		requireCommands swaymsg
	else
		_error "Unsupported compositor. Only sway & niri"
	fi
	requireCommands jq

	window_pid=$(focusedPid)
	requirePid "$window_pid" "No focused window with a pid"

	# the compositor reports the xwayland proxy, so ask X which client owns the window
	case "$(ps -o comm= -p "$window_pid")" in
		Xwayland | xwayland-satell)
			command -v xdotool >/dev/null || _error "xdotool is required to freeze X11 windows"
			window_pid=$(DISPLAY="${DISPLAY:-:0}" xdotool getactivewindow getwindowpid 2>/dev/null)
			requirePid "$window_pid" "Could not find the X11 client"
			;;
	esac

	window_name=$(ps -o comm= -p "$window_pid")
	window_stat=$(ps -o stat= -p "$window_pid")
	[ -n "$window_stat" ] || _error "Process $window_pid is gone"

	case "$window_stat" in
		T*)
			signalTree CONT "$window_pid"
			forgetManual "$window_pid"
			_info "Resumed $window_name ($window_pid)"
			_notify "Resumed $window_name"
			;;
		*)
			isSkipped "$window_pid" && _error "Refusing to freeze $window_name ($window_pid)"
			recordManual "$window_pid"
			signalTree STOP "$window_pid"
			_info "Froze $window_name ($window_pid)"
			_notify "Froze $window_name"
			;;
	esac
}

# comm is cut at 15 chars and an AppImage runs under a different comm, so also match argv[0]'s basename
findPids() {
	name_re=$(printf '%s' "$1" | sed 's/[][\.*^$+?(){}|]/\\&/g')
	{
		pgrep -x -U "$(id -u)" "$name_re" 2>/dev/null
		pgrep -f -U "$(id -u)" "^([^ ]*/)?$name_re( |\$)" 2>/dev/null
	} | sort -u
}

stopByName() {
	for name in "$@"; do
		for named_pid in $(findPids "$name"); do
			if isSkipped "$named_pid"; then
				_info "Skipping $name ($named_pid)"
				continue
			fi
			signalTree STOP "$named_pid"
		done
	done
}

startByName() {
	for name in "$@"; do
		for named_pid in $(findPids "$name"); do
			isHeldManual "$named_pid" || signalTree CONT "$named_pid"
		done
	done
}

resumeAll() {
	[ -f "$state_file" ] || return 0
	while read -r manual_pid; do
		signalTree CONT "$manual_pid"
	done <"$state_file"
	: >"$state_file"
}

requireCommands ps pgrep

action=${1:-}
[ $# -gt 0 ] && shift

case "$action" in
	window) toggleWindow ;;
	resume-all) resumeAll ;;
	stop) stopByName "$@" ;;
	start) startByName "$@" ;;
	*) _info "Usage: freeze window | resume-all | stop <prog>... | start <prog>..." ;;
esac
